# =============================================================================
# EVENTIVO — auth-service · variables de entorno
# -----------------------------------------------------------------------------
# REGLA (TT-02): este archivo NO contiene valores reales de producción.
# Los valores que ves aquí son SOLO para desarrollo local (docker-compose.dev).
# Para producción: copia este archivo a `.env` y pon los valores reales
# (los secretos NO se versionan jamás — ver .gitignore).
#
# Los secretos de producción se configuran en GitHub Secrets con los
# nombres DOCUMENTADOS en el README raíz del repositorio.
# =============================================================================

# ---------- Servidor ----------
PORT=3001
NODE_ENV=development

# ---------- PostgreSQL (desarrollo local: docker/docker-compose.dev.yml) ----------
# En producción se prefiere una única DATABASE_URL:
# DATABASE_URL=postgresql://usuario:clave@host:5432/auth_db
# Si DATABASE_URL no está definida, se usan las variables DB_* siguientes:
DB_HOST=localhost
DB_PORT=5432
DB_USER=eventivo
DB_PASSWORD=eventivo_desarrollo_local
DB_NAME=auth_db

# ---------- JWT (DT-05: access corto + refresh rotativo con hash) ----------
# En desarrollo local cualquier valor de >= 32 caracteres sirve.
# En producción y CI se inyecta desde GitHub Secrets (JWT_SECRET).
JWT_SECRET=clave-local-de-desarrollo-eventivo-cambiar-1234567890
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=https://api.eventivo.ucv.edu.pe
JWT_AUDIENCE=eventivo-app

# ---------- Red interna de servicios (DT-02) ----------
# Clave X-Service-Key para rutas internas /internal/* (configurada por secret en producción).
X_SERVICE_KEY=x-service-key-local-desarrollo-eventivo

# ---------- Seeds (RF-19, solo demo) ----------
# Contraseña común FICTICIA de los usuarios de seed. Solo existe en el entorno de
# demo/desarrollo; nunca debe usarse con datos reales (R-09).
SEED_ADMIN_EMAILS=admin1@eventivo.ucv.edu.pe,admin2@eventivo.ucv.edu.pe
SEED_ADMIN_PASSWORD=EventivoDemo2026!

# ---------- Rate limiting (RF-02: 10 intentos / 15 min por IP+email) ----------
LOGIN_RATE_LIMIT_LIMIT=10
LOGIN_RATE_LIMIT_TTL_MS=900000